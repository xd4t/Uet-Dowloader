{
  "manifest_version": 3,
  "name": "UET Portal - Tải tài liệu nhanh",
  "version": "1.3",
  "description": "Tick chọn nhiều file trên portal.uet.vnu.edu.vn và tải cùng lúc. Bật/tắt khi cần.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://portal.uet.vnu.edu.vn/*"
  ],
  "action": {
    "default_title": "UET Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.uet.vnu.edu.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "uet-downloader@example.local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}